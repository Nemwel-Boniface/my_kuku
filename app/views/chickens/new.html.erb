<% if user_signed_in? %>
  <main class="devise">
    <h2 class="header">Add a New Chicken</h2>

    <section class="signup">
      <div class="signupleft">
        
        <%= image_tag("freerangehens.jpg", alt: "Image of chicken in a farm") %>
      </div>

      <div class="signupright">
        <%= form_with(model: @chicken) do |form| %>
          <% if @chicken.errors.any? %>
            <div style="color: red">
              <h2><%= pluralize(@chicken.errors.count, "error") %> prohibited this chicken from being saved:</h2>
              <ul>
                <% @chicken.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="signupinput">
            <%= form.text_field :tag_number, placeholder: "Tag Number", type: :hidden %>
          </div>

          <div class="signupinput">
            <%= form.label :chicken_image %>
            <%= form.file_field :chicken_image %>
            <div id="image-preview"></div>
          </div>

          <div class="signupinput">
            <%= form.number_field :age, type: :hidden, placeholder: "Age in weeks" %>
          </div>

          <div class="signupinput">
            <%= form.label :date_hatched %>
            <%= form.date_field :date_hatched %>
          </div>

          <div class="signupinput">
            <%= form.label :parent_id %>
            <%= form.text_field :parent_id, placeholder: "Parent ID" %>
          </div>

          <%= form.hidden_field :user_id, value: current_user.id %>

          <div class="devisesubmit">
            <%= form.submit "Add Chicken" %>
          </div>
        <% end %>
      </div>
    </section>
  </main>
<% else %>
  <main class="chickensPage">
    <p>Kindly login to create a chicken</p>
  </main>
<% end %>
