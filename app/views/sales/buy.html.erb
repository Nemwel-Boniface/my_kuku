<div class="page-wrapper">
  <h1 class="page-title">Buy Items</h1>

  <h2 class="section-title">Eggs</h2>
  <%= form_with url: new_sale_path, method: :get do |form| %>
    <div class="table-wrapper">
      <table class="styled-table">
        <thead>
          <tr>
            <th>Poultry Type</th>
            <th>Egg Size</th>
            <th>Price Per Egg (KES)</th>
            <th>Available Quantity</th>
            <th>Quantity</th>
          </tr>
        </thead>
        <tbody>
          <% @eggs.each do |egg| %>
            <tr>
              <td><%= egg.poultry_type.capitalize %></td>
              <td><%= egg.egg_size %></td>
              <td><%= number_to_currency(egg.avg_price, unit: "KES ", format: "%u%n") %></td>
              <td><%= egg.total_eggs %></td>
              <td>
                <%= number_field_tag "items[eggs][#{egg.poultry_type}_#{egg.egg_size}][quantity]", 0, min: 0, class: 'quantity-field' %>
                <%= hidden_field_tag "items[eggs][#{egg.poultry_type}_#{egg.egg_size}][price_per_unit]", egg.avg_price %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <h2 class="section-title">Poultry</h2>
    <div class="table-wrapper">
      <table class="styled-table">
        <thead>
          <tr>
            <th>Poultry Type</th>
            <th>Price (KES)</th>
            <th>Available Quantity</th>
            <th>Quantity</th>
          </tr>
        </thead>
        <tbody>
          <% @chickens.each do |chicken| %>
            <tr>
              <td><%= chicken.poultry_type.capitalize %></td>
              <td><%= number_to_currency(chicken.price_per_poultry, unit: "KES ", format: "%u%n") %></td>
              <td><%= chicken.no_of_poultry %></td>
              <td>
                <%= number_field_tag "items[poultry][#{chicken.poultry_type}][quantity]", 0, min: 0, class: 'quantity-field' %>
                <%= hidden_field_tag "items[poultry][#{chicken.poultry_type}][price_per_unit]", chicken.price_per_poultry %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="action-container">
      <%= form.submit "Proceed to Invoice", class: 'action-button' %>
    </div>
  <% end %>
</div>
