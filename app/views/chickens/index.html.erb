<p style="color: green"><%= notice %></p>

<header class="aboutheader">
  <h2>Poultry</h2>
  <h3><%= link_to "Home", root_path %> <span>-</span>Poultry</h3>
</header>

<main class="chickens">
  <% if user_signed_in? %>
    <% if current_user.role == "admin" || current_user.role == "worker" %>
      <div class="newchickenlink">
        <h2 class="darkgreentext">Let's create a new Poultry</h2>
        <p><%= link_to "New Poultry", new_chicken_path %></p>
      </div>
    <% else %>
      <div class="userMessage">
        <h2 class="darkgreentext">Explore the poultry we have available!</h2>
        <p>Browse through the records of poultry listed below.</p>
      </div>
    <% end %>
  <% end %>

  <section class="chickensWrapper">
    <% if @chickens.empty? %>
      <h2>There are no created Poultry yet</h2> 
    <% else %>
      <% @chickens.each do |chicken| %>
        <div class="chicken">
          <% if chicken.chicken_image.attached? %>
            <image src="<%= url_for(chicken.chicken_image) %>">
          <% end %>

          <div>
            <p>
              <strong>Poultry type:</strong>
              <%= chicken.poultry_type.capitalize %>
            </p>

            <p>
              <strong>Number of Poultry:</strong>
              <%= chicken.no_of_poultry %>
            </p>

            <p>
              <strong>Price per Poultry:</strong>
              <%= chicken.price_per_poultry %>
            </p>

            <p>
              <strong>Total price of Poultry:</strong>
              KES <%= chicken.total_price %>
            </p>

            <% if user_signed_in? && (current_user.role == "admin" || current_user.role == "worker") %>
              <p class="chickenlink">
                <%= link_to "Add more #{chicken.poultry_type.capitalize}", edit_chicken_path(chicken) %>
                <i class="fa fa-arrow-right" aria-hidden="true"></i>
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
</main>
